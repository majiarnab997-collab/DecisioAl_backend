# Port to run backend server on
PORT=5000

# Environment mode
NODE_ENV=development

# MongoDB Connection String (Atlas recommended)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/decisioai?retryWrites=true&w=majority

# JWT secret key for token signing
JWT_SECRET=your_super_secret_jwt_key_decisioai_2025_secure_key

# Google Gemini API Key
GEMINI_API_KEY=your_google_gemini_api_key

# Client URL for CORS
CLIENT_URL=http://localhost:5173
